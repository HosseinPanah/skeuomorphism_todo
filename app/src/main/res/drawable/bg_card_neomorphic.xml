<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base shadow for raised effect -->
    <item android:bottom="4dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <solid android:color="@color/shadow_soft" />
            <alpha android:alpha="0.1" />
        </shape>
    </item>
    
    <!-- Top highlight for neomorphic effect -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <solid android:color="@color/shadow_highlight" />
            <alpha android:alpha="0.05" />
        </shape>
    </item>
    
    <!-- Card background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <solid android:color="@color/surface_raised" />
        </shape>
    </item>
</layer-list>
