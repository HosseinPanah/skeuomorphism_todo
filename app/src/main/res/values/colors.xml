<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Monochrome Palette -->
    <color name="near_black">#0D0D0D</color>
    <color name="black">#111111</color>
    <color name="dark_gray">#181818</color>
    <color name="medium_dark_gray">#242424</color>
    <color name="gray">#3A3A3A</color>
    <color name="medium_gray">#666666</color>
    <color name="light_gray">#A0A0A0</color>
    <color name="soft_gray">#C8C8C8</color>
    <color name="off_white">#E8E8E8</color>
    <color name="white">#F2F2F2</color>

    <!-- Accent Colors (LED indicators) -->
    <color name="muted_red">#8F3F3F</color>
    <color name="muted_red_alpha">#A94A4A</color>
    <color name="muted_green">#4F7056</color>
    <color name="muted_green_alpha">#527A5A</color>
    <color name="muted_blue">#536B80</color>
    <color name="muted_blue_alpha">#526A82</color>

    <!-- Surface Colors -->
    <color name="surface_raised">#191919</color>
    <color name="surface_default">#141414</color>
    <color name="surface_inset">#0A0A0A</color>
    <color name="surface_raised_light">#E7E7E7</color>
    <color name="surface_default_light">#E2E2E2</color>
    <color name="surface_inset_light">#D5D5D5</color>

    <!-- Text Colors -->
    <color name="text_primary">#D8D8D8</color>
    <color name="text_secondary">#777777</color>
    <color name="text_primary_light">#242424</color>
    <color name="text_secondary_light">#666666</color>

    <!-- Background Colors -->
    <color name="background_dark">#0D0D0D</color>
    <color name="background_light">#DCDCDC</color>

    <!-- Shadow Colors -->
    <color name="shadow_soft">#000000</color>
    <color name="shadow_highlight">#FFFFFF</color>

    <!-- Status Indicators -->
    <color name="status_success">@color/muted_green</color>
    <color name="status_warning">@color/muted_red</color>
    <color name="status_active">@color/muted_blue</color>
    <color name="status_inactive">@color/medium_gray</color>

    <!-- Progress Colors -->
    <color name="progress_track">@color/medium_dark_gray</color>
    <color name="progress_indicator">@color/soft_gray</color>
    <color name="progress_complete">@color/muted_green</color>

    <!-- Button States -->
    <color name="button_enabled">@color/surface_raised</color>
    <color name="button_pressed">@color/surface_inset</color>
    <color name="button_disabled">@color/dark_gray</color>

    <!-- Toggle Colors -->
    <color name="toggle_track">@color/medium_dark_gray</color>
    <color name="toggle_thumb">@color/surface_raised</color>
    <color name="toggle_active">@color/muted_blue</color>

    <!-- Card Colors -->
    <color name="card_background">@color/surface_raised</color>
    <color name="card_stroke">@color/dark_gray</color>
    <color name="card_pressed">@color/surface_inset</color>

    <!-- Navigation Colors -->
    <color name="nav_selected">@color/muted_blue</color>
    <color name="nav_unselected">@color/medium_gray</color>
    <color name="nav_background">@color/near_black</color>

    <!-- Divider Colors -->
    <color name="divider">@color/dark_gray</color>
    <color name="divider_light">@color/soft_gray</color>

    <!-- Overlay Colors -->
    <color name="overlay_dark">#80000000</color>
    <color name="overlay_light">#80FFFFFF</color>
    <color name="overlay_dimmer">#CC000000</color>
</resources>
